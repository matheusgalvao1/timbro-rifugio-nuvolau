{
  "name": "timbro-rifugio-nuvolau",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @nuvolau/api dev\" \"pnpm --filter @nuvolau/web dev\"",
    "build": "pnpm --filter @nuvolau/web build",
    "deploy": "pnpm --filter @nuvolau/web build && pnpm --filter @nuvolau/api deploy",
    "db:generate": "pnpm --filter @nuvolau/db generate",
    "db:local": "pnpm --filter @nuvolau/api migrate:local",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
